{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ip-assess-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // 公開URLは持たない（web Worker から Service Binding 経由でのみ呼ばれる）
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ip-assess",
      // `npx wrangler d1 create ip-assess` で作成した ID に置き換える
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ai": { "binding": "AI" },
  "queues": {
    "producers": [{ "binding": "AI_QUEUE", "queue": "ip-assess-ai" }],
    "consumers": [{ "queue": "ip-assess-ai", "max_batch_size": 1, "max_retries": 3 }]
  },
  // 毎日 00:05 JST（15:05 UTC）に、前日に上限を超えた AI 評価を投入する
  "triggers": { "crons": ["5 15 * * *"] },
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }
  ],
  "vars": {
    "AI_DAILY_LIMIT": "20",
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "AI_LANGUAGE": "English",
    "DOH_ENDPOINT": "https://cloudflare-dns.com/dns-query"
  },
  // Spamhaus DQS を使う場合: `npx wrangler secret put SPAMHAUS_DQS_KEY`

  "env": {
    // ログインなしのローカル実行用（`npm run dev:local`）
    //   Workers AI はローカルで動かせず、バインディングがあるとリモート接続を要求されるため外す。
    //   AI 評価はキューで再試行したあと failed になる
    //   バインディングは環境ごとに継承されないため、AI 以外は上と同じ内容を書く
    "local": {
      "name": "ip-assess-api",
      "d1_databases": [
        { "binding": "DB", "database_name": "ip-assess", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
      ],
      "queues": {
        "producers": [{ "binding": "AI_QUEUE", "queue": "ip-assess-ai" }],
        "consumers": [{ "queue": "ip-assess-ai", "max_batch_size": 1, "max_retries": 3 }]
      },
      "ratelimits": [
        { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }
      ],
      "vars": {
        "AI_DAILY_LIMIT": "20",
        "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
        "AI_LANGUAGE": "English",
        "DOH_ENDPOINT": "https://cloudflare-dns.com/dns-query"
      }
    }
  }
}
